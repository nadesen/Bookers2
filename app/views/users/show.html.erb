<div class="container">
  <div class="row">
    <div class="col-md-3">
      # User info and New book
      <%= render 'users/list', users: @users %>
    </div>


    <div class="col-md-8 offset-md-1">

      <h2>My Books</h2>
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Opinion</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% @books.each do |book| %>
              <tr>
                <td><%= link_to book.title, book_path(book) %></td>
                <td><%= book.body %></td>
                <% if current_user == book.user %>
                  <td><%= link_to 'Edit', edit_book_path(book), class: "btn btn-secondary" %></td>
                  <td><%= link_to 'Destroy', book, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>

    </div>
  </div>
</div>