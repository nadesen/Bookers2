<div class="container">
  <div class="row">
    <div class="col-md-3">
      <%- # User info and New book -%>
      <%= render 'users/list', user: current_user %>
    </div>


    <div class="col-md-8 offset-md-1">

      <h2>Users</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <% if user.profile_image.attached? %>
                  <%= image_tag user.profile_image.variant(resize_to_limit: [100, 100]), alt: user.name, class: "user-image" %>
                <% else %>
                  <%= image_tag "no_image.jpg", alt: "No image", class: "user-image" %>
                <% end %>
              </td>
              <td><%= user.name %></td>
              <td>
                <% if current_user == user %>
                  <%= link_to 'Show', user_path(current_user), class: "btn btn-secondary" %>
                <% else %>
                  <%= link_to 'Show', user_path(user), class: "btn btn-secondary" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>
