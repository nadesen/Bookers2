<h2>User info</h2>
<div class="user-info-box">
  <% if user %>
    <% if user.profile_image.attached? %>
      <%= image_tag user.profile_image.variant(resize_to_limit: [100, 100]), alt: user.name, class: "user-image" %>
    <% else %>
      <%= image_tag "no_image.jpg", alt: "No image", class: "user-image" %>
    <% end %>

    <p>
      <strong>Name:</strong>
      <%= user.name %>
    </p>
    <p>
      <strong>Introduction:</strong>
      <%= user.introduction.presence %>
    </p>

    <%= link_to edit_user_path(user), class: "btn btn-secondary btn-block" do %>
      <i class="fa-solid fa-user-gear"></i>
    <% end %>
  <% else %>
    <p>Please log in.</p>
  <% end %>
</div>


<% if @book.errors.any? %>
  <div id="error_explanation">
  <span style="color: red; font-weight: bold;"><%= @book.errors.count %> errors prohibited this book from being saved:</span>
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<h2>New book</h2>
<%= form_with model: Book.new do |f| %>
  <h4>Title</h4>
  <%= f.text_field :title %>
  
  <h4>Opinion</h4>
  <%= f.text_area :body %>
  
  <%= f.submit 'Create Book' %>
<% end %>