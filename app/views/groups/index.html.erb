<% content_for :title, "Groups" %>

<div class="container">
  <div class="row">
    <div class="col-md-3">
      <h2>User info</h2>
      <!-- User sidebar content here -->
    </div>
    
    <div class="col-md-8 offset-md-1">
      <h2>Groups</h2>
      <%= link_to "New group", new_group_path, class: "btn btn-success mb-3" %>
      
      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Introduction</th>
            <th>Members</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr>
              <td><%= image_tag 'no_image.jpg', size: "50x50" %></td>
              <td><%= link_to group.name, group_path(group) %></td>
              <td><%= group.introduction %></td>
              <td><%= group.members.count %></td>
              <td>
                <% if group.owner == current_user %>
                  <%= link_to "Edit", edit_group_path(group), class: "btn btn-sm btn-success" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>