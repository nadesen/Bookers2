<div class="mx-auto col-11 col-sm-10 col-lg-8 col-xl-6 text-center">
  <h1>welcome to Bookers !!</h1>
  <p>
    Share your favorite books!
  </p>

  <div class="btn-wrapper col-10 mx-auto">

    <div style="margin-top: 20px;">
        <% if user_signed_in? %>
          <%= link_to "Go to My Page", user_path(current_user), class: "btn btn-info" %>
        <% else %>
          <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary", style: "margin-right: 10px;" %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-success" %>
        <% end %>
    </div>
  </div>
</div>
