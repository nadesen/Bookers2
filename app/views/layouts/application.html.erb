<!DOCTYPE html>
<html>
  <head>
    <title>Bookers2</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/52f4aa1313.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header>
        <div class="container-fluid navbar-dark bg-dark">
          <div class="header row py-4">
            <div class="col-2 offset-2">
              <strong><%= link_to "Bookers", root_path, class: "text-white" %></strong>
            </div>

            <div class="col-8">
              <div class="row">

                <% if user_signed_in? %>
                  <div class="col-1 px-2 offset-6">
                    <strong>
                      <%= link_to user_path(current_user), class: "text-white" do %>
                        <i class="fa-solid fa-house me-1"></i>
                        Home
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to users_path, class: "text-white" do %>
                        <i class="fa-solid fa-users"></i>
                        Users
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to books_path, class: "text-white" do %>
                        <i class="fa-solid fa-book-open"></i>
                        Books
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to destroy_user_session_path, method: :delete, class: "text-white" do %>
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Log out
                      <% end %>
                    </strong>
                  </div>
                <% else %>
                  <div class="col-1 px-2 offset-6">
                    <strong>
                      <%= link_to root_path, class: "text-white" do %>
                        <i class="fa-solid fa-house me-1"></i>
                          Home
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to about_path, class: "text-white" do %>
                        <i class="fa-solid fa-link"></i>
                        About
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to new_user_registration_path, class: "text-white" do %>
                        <i class="fa-solid fa-user-plus"></i>
                        Sign up
                      <% end %>
                    </strong>
                  </div>
                  <div class="col-1 px-2">
                    <strong>
                      <%= link_to new_user_session_path, class: "text-white" do %>
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Log in
                      <% end %>
                    </strong>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <div>
        <%= flash[:notice] %>
      </div>

      <%= yield %>

    </main>

    <footer>
      <div class="container mt-5">
        <div class="row">
          <div class="mx-auto">
            <p>CopyRight Infratop.inc</p>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>
